export GOOGLE_API_KEY="your_google_api_key"

# Fallback model used when no agent-specific model list is set.
export LLM_MODEL="gemma-4-26b-a4b-it"

# Comma-separated candidate model lists. The runtime will try the next model
# when it sees quota, rate limit, or transient backend errors.
export ROUTER_LLM_MODELS="gemini-2.5-flash,gemini-3.5-flash,gemini-3.1-flash-lite,gemini-2.5-flash-lite"
export WEATHER_LLM_MODELS="gemini-3.5-flash,gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemma-4-26b-a4b-it,gemma-4-31b-it"
export SEARCH_LLM_MODELS="gemini-2.5-flash,gemini-3.5-flash,gemini-3.1-flash-lite,gemini-2.5-flash-lite"

# Optional proxy settings.
export http_proxy="http://127.0.0.1:7897"
export https_proxy="http://127.0.0.1:7897"

# QWeather API settings.
export weather_api_key="your_qweather_api_key"
export weather_api_url="https://your-api-host.re.qweatherapi.com"
